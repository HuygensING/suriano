PROJECT=suriano

# Set this to 1 if the services should be started and stopped
# automatically via `make`. Set this to 0 in production settings 
# where existing services are already deployed. In the latter case,
# set up all variables here to communicate with these existing services.
MANAGE_SERVICES=1

# The base URL must be accessible from all sides (both inside and outside containers)
# that require access. Tt will be also be the URL advertised in the web annotation output
BASE_URL=http://${HOSTNAME}

MONGODB_PORT=27017
MONGODB_USER=root
MONGODB_PASSWORD=example
MONGODB_HOST=mongodb_${PROJECT}

ANNOREPO_HOST=annorepo_${PROJECT}
ANNOREPO_PORT=8080
ANNOREPO_VERSION=0.8.0
ANNOREPO_CTL_PORT=8081
ANNOREPO_ROOT_API_KEY=6a11f8b6-432b-11ed-b878-0242ac120002
ANNOREPO_URL=${BASE_URL}:${ANNOREPO_PORT}
MONGODB_VERSION=6.0.27

BROCCOLI_HOST=broccoli_${PROJECT}
BROCCOLI_PORT=8082
BROCCOLI_VERSION=textsurf-3
BROCCOLI_URL=${BASE_URL}:${BROCCOLI_PORT}

TEXTSURF_HOST=textsurf_${PROJECT}
TEXTSURF_PORT=8083
TEXTSURF_VERSION=0.5.0
TEXTSURF_UNLOADTIME=600
TEXTSURF_URL=${BASE_URL}:${TEXTSURF_PORT}

ELASTIC_HOST=elastic_${PROJECT}
ELASTIC_PORT=9200
ELASTIC_MEMORY_LOCK=false
ELASTIC_JAVA_MEM=512
ELASTIC_URL=${BASE_URL}:${ELASTIC_PORT}

CANTALOUPE_HOST=cantaloupe_${PROJECT}
CANTALOUPE_VERSION=5.0.7-0
CANTALOUPE_PORT=8084
CANTALOUPE_URL=${BASE_URL}:${CANTALOUPE_PORT}

#The name of surfdrive in your rclone config (needed to download scans, the scans must have been explicitly shared with you for this to work!)
RCLONE_SURFDRIVE=surfdrive_knaw

#HTTP server for static files such as apparatus and manifests
NGINX_HOST=nginx_${PROJECT}
NGINX_VERSION=1.28.0
NGINX_PORT=8040
NGINX_URL=${BASE_URL}:${NGINX_PORT}
